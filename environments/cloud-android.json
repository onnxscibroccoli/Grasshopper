{
  "schema": "omnikali.environment/v1",
  "kind": "cloud-android",
  "version": "1.0.0",
  "execution": {
    "interactive": true,
    "persistent": true,
    "privileged_android_shell": false,
    "provider": "oracle-cloud",
    "region": "us-ashburn-1",
    "host": "grasshopper-workstation",
    "auth": "instance-local-workstation",
    "compute": "workstation-local-podman-qemu"
  },
  "control": {
    "screen": true,
    "input": true,
    "adb": true,
    "human_gate": true,
    "bidirectional": true
  },
  "parameters": {
    "transport": "adb+vnc+websocket",
    "display": "qemu-vnc",
    "rebuild_source": "legacy-known-good",
    "resource_profile": {
      "memory_gb": 2,
      "cpus": 2,
      "acceleration": "tcg",
      "resource_admission_required": true
    },
    "aws_cloud_android": "disabled",
    "legacy_benchmark": "salvage/cloud-android-agentic-device-20261005"
  }
}
