[Unit]
Description=Grasshopper noVNC web gateway
After=grasshopper-vnc.service network.target
Requires=grasshopper-vnc.service

[Service]
Type=simple
ExecStart=/opt/noVNC/utils/novnc_proxy --listen REDACTED_IP:6080 --vnc localhost:5901
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
