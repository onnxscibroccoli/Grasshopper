[Unit]
Description=Grasshopper self-hosted MCP tool gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grasshopper
Group=grasshopper
WorkingDirectory=/srv/grasshopper
Environment=MCP_HOST=REDACTED_IP
Environment=MCP_PORT=8765
Environment=MCP_TOKEN_FILE=/etc/grasshopper-mcp/token
ExecStart=/usr/bin/python3 /srv/grasshopper/mcp_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/srv/grasshopper
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
