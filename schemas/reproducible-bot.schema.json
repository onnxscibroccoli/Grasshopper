{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Broccoli reproducible bot recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "status",
    "device_targets",
    "capabilities",
    "preconditions",
    "actions",
    "acceptance",
    "rollback",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "broccoli.bot/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,80}$"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "TESTED",
        "REVIEWED",
        "PROVEN",
        "REVALIDATE"
      ]
    },
    "device_targets": {
      "type": "array",
      "items": {
        "enum": [
          "local-android",
          "cloud-android",
          "linux",
          "browser",
          "mcp-api"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.:-]+$"
      },
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "semantic_target",
          "idempotency_scope"
        ],
        "properties": {
          "intent": {
            "type": "string"
          },
          "semantic_target": {
            "type": "string"
          },
          "idempotency_scope": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "expected_postcondition"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "expected_postcondition": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 5
    },
    "provenance": {
      "type": "object",
      "required": [
        "repo",
        "source_branch",
        "review_pr"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "source_branch": {
          "const": "main"
        },
        "review_pr": {
          "type": "string"
        }
      }
    }
  }
}
