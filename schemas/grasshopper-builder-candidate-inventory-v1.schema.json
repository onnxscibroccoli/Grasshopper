{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grasshopper.invalid/schemas/builder-candidate-inventory-v1.schema.json",
  "title": "Grasshopper ARM64 userdebug builder candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observed_utc", "build_authorized", "overall_status", "candidates"],
  "properties": {
    "schema": { "const": "grasshopper.builder-candidate-inventory/v1" },
    "contract_id": { "type": "string", "minLength": 1 },
    "observed_utc": { "type": "string", "format": "date-time" },
    "build_authorized": { "const": false },
    "overall_status": {
      "enum": ["NO_ELIGIBLE_NODE", "LIVE_COLLECTION_CANDIDATE"]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidateStatus": {
      "enum": [
        "BLOCKED_RESOURCE_ADMISSION",
        "ELIGIBLE_FOR_LIVE_COLLECTION",
        "EXCLUDED_PAID_PROVISIONING",
        "EXCLUDED_PROTECTED",
        "EXCLUDED_PROVISIONING_REQUIRED",
        "UNQUALIFIED_IDENTITY",
        "UNQUALIFIED_NO_SNAPSHOT"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "architecture",
        "logical_cpus",
        "memory_total_bytes",
        "memory_available_bytes",
        "workspace_free_bytes",
        "load_1m",
        "qemu_processes",
        "lease_hours",
        "checkpoint_path"
      ],
      "properties": {
        "schema": { "const": "grasshopper.builder-snapshot/v1" },
        "architecture": { "type": "string", "minLength": 1 },
        "logical_cpus": { "type": "integer", "minimum": 1 },
        "memory_total_bytes": { "type": "integer", "minimum": 0 },
        "memory_available_bytes": { "type": "integer", "minimum": 0 },
        "workspace_free_bytes": { "type": "integer", "minimum": 0 },
        "load_1m": { "type": "number", "minimum": 0 },
        "qemu_processes": { "type": "integer", "minimum": 0 },
        "lease_hours": { "type": "number", "minimum": 0 },
        "checkpoint_path": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "protected",
        "paid_capacity_authorized",
        "access_status",
        "identity_status",
        "evidence_source",
        "declared_status",
        "snapshot"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "minLength": 1 },
        "protected": { "type": "boolean" },
        "paid_capacity_authorized": { "type": "boolean" },
        "requires_paid_provisioning": { "type": "boolean" },
        "requires_new_provisioning": { "type": "boolean" },
        "access_status": { "type": "string", "minLength": 1 },
        "identity_status": { "type": "string", "minLength": 1 },
        "evidence_source": { "type": "string", "minLength": 1 },
        "declared_status": { "$ref": "#/$defs/candidateStatus" },
        "snapshot": {
          "type": ["object", "null"],
          "$ref": "#/$defs/snapshot"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
