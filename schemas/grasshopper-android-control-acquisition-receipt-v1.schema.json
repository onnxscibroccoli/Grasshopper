{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grasshopper.invalid/schemas/android-control-acquisition-receipt-v1.schema.json",
  "title": "Grasshopper Android control acquisition artifact receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "collection_mode", "collected_utc", "requirements", "binding", "guest_process", "origins", "verification_mode", "verifier_dispatches_or_connects", "live_acceptance", "r2"],
  "properties": {
    "schema": { "const": "grasshopper.android-control-acquisition-receipt/v1" },
    "contract_id": { "type": "string", "minLength": 1 },
    "collection_mode": { "enum": ["LIVE", "TEST_FIXTURE"] },
    "collected_utc": { "type": "string", "format": "date-time" },
    "requirements": { "$ref": "#/$defs/artifact" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "session_id"],
      "properties": {
        "source_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "session_id": { "type": "string", "minLength": 1 }
      }
    },
    "guest_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_identity", "pid", "started_utc", "observed_utc", "fingerprint_sha256"],
      "properties": {
        "node_identity": { "type": "string", "minLength": 1 },
        "pid": { "type": "integer", "minimum": 1 },
        "started_utc": { "type": "string", "format": "date-time" },
        "observed_utc": { "type": "string", "format": "date-time" },
        "fingerprint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "origins": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/origin" }
    },
    "verification_mode": { "const": "RECEIPT_ONLY" },
    "verifier_dispatches_or_connects": { "const": false },
    "live_acceptance": { "const": false },
    "r2": { "const": "NOT_PROVEN" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "artifact"],
      "properties": {
        "gate": { "enum": ["delivery", "visible_acknowledgement", "semantic_effect", "reconnect_continuity"] },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "node_identity", "transport", "session_id", "entries"],
      "properties": {
        "origin": { "enum": ["workstation", "browser", "physical_android"] },
        "node_identity": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    }
  }
}
