{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onnxscibroccoli.github.io/schemas/chat-archive/message.schema.json",
  "title": "ChatArchiveMessage",
  "type": "object",
  "required": ["message_id", "conversation_id", "role", "timestamp", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["user", "assistant", "system", "tool", "other"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "content": { "type": "string" },
    "content_hash": { "type": "string", "minLength": 32 },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mime": { "type": "string" },
          "hash": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "protected": { "type": "boolean", "default": false },
    "quarantine_ref": { "type": ["string", "null"] },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
